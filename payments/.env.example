MP_MODE=test
PAYMENTS_CHECKOUT_ENABLED=false
MP_COMMERCIAL_AUTHORIZATION=PENDING
MINCETUR_AUTHORIZATION_CONFIRMED=NO
PAYMENTS_API_BASE=https://YOUR-CLOUD-RUN-URL
MP_COLLECTOR_ID=YOUR_MERCADO_PAGO_COLLECTOR_ID
